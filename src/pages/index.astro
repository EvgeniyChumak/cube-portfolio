---
import '/src/falling-panels.css';
import '../industrial-scene.css';
import IndustrialScene from '../components/IndustrialScene.astro';
import projects from '../data/cases.json';
import CasePanel from '../components/CasePanel.astro';
const modules = [
 {x:0,y:0,n:1,title:'A different perspective.',label:'INTRODUCTION',text:'Начало маршрута. Скролл перемещает камеру вправо вдоль трубы.'},
 {x:1120,y:0,n:1,title:'About me.',label:'ABOUT',text:''},
 {x:2240,y:0,n:4,title:'My path so far.',label:'CASE STUDY / 03',text:'Камера остановилась. Следующие три секции — стороны одной треугольной призмы.'},
 {x:3360,y:0,n:1,title:'My works.',label:'SELECTED WORK',text:'История закончилась. Камера движется вправо вдоль трубы.'},
 ...projects.map((project,index)=>({x:3360,y:(index+1)*640,n:4,title:project.title,label:'CASE STUDY',text:project.description})), 
];
const career = [
 [
 ['2021','University','Enrolled in Computer Engineering at Odesa Polytechnic National University and began studying frontend development.'],
 ['2022','Frontend Development','Completed an intensive frontend development course, learned React fundamentals, and worked on several team and non-commercial projects.'],
 ],
 [
 ['2023 – Spring 2024','Freelance Developer','Worked with direct clients and agencies across Webflow and frontend development, delivering 10+ commercial websites and occasionally taking responsibility for design.'],
 ['Spring 2024 – Autumn 2026','Lead Developer at Marketer UX','Worked on more than 50 projects for international clients, primarily in the DACH region, and independently delivered 30+ websites from Figma to production, including complex CMS architecture, custom JavaScript, GSAP animations, API integrations, authentication and subscription systems.'],
 ['Now','Independent Developer','Following a long-term agency collaboration, I now partner directly with clients and agencies to deliver websites using Astro, Next.js, React and Webflow — taking ownership of development from technical planning to production.'],
 ],
];
const names=['Overview','Challenge','Approach','Execution','Outcome'];
---
<html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Portfolio — Pipe study</title></head>
<body>
<div class="preloader" role="status" aria-label="Loading portfolio">
 <div class="loading-art" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
 <div class="loading-caption"><span>YEVHEN CHUMAK</span><span class="loading-label">LOADING</span></div>
</div>
<noscript><style>.preloader{display:none}</style></noscript>
<main class="stage" aria-label="Прототип трубы"><div class="camera"><div class="world">
<IndustrialScene/>
{modules.map((m,i)=><div class:list={['module',{'case-module':m.n>1}]} data-module={i} data-count={m.n} data-x={m.x} data-y={m.y} style={`left:${m.x}px;top:${m.y}px;--radius:${m.n>1?560/Math.tan(Math.PI/m.n):160}px`}>
 {m.n===1&&<div class="shell"><div class="wall wall-top"></div><div class="wall wall-bottom"></div><div class="wall wall-left"></div><div class="wall wall-right"></div><div class="wall wall-back"></div><div class="city-box rooftop-unit" style="left:660px;top:-48px;transform:translateZ(-180px);--bw:100px;--bh:48px;--bd:70px">{['front','back','left','right','top'].map(side=><div class={`box-face box-${side}`}></div>)}</div><div class="roof-aerial"></div><div class="roof-parapet"></div></div>}
 <div class="rotor">
 {Array.from({length:m.n},(_,face)=><section class:list={['panel',{'case-panel':m.n>1,'hero':i===0,'about':i===1,'timeline-panel':i===2,'works-panel':i===3,'project-panel':i>=4}]} data-face={face} style={m.n>1?`transform:rotate${i===2?'X':'Y'}(${face*360/m.n}deg) translateZ(${(i===2?320:560)/Math.tan(Math.PI/m.n)}px);--tone:${face%2?'#171a1c':'#eeeee9'};--ink:${face%2?'#eeeee9':'#171a1c'}`:''} inert>
{i===0&&<div class="design-content">
<div class="hero-menu" role="navigation" aria-label="Main navigation"><button data-go="4">My Works</button><button data-go="1">About me</button><a href="mailto:gekachumak@gmail.com">Contact</a><a href="https://yevhen-chumak.vercel.app/#skills" target="_blank" rel="noopener noreferrer">Skills</a><a href="https://yevhen-chumak.vercel.app/#services" target="_blank" rel="noopener noreferrer">Services</a></div>
<h1 class="square-title">Hello, I`m Yevhen</h1>
<p class="square-description">I’m a developer with 4 years of commercial experience and more than 50 completed projects, building large, complex websites across frontend development and Webflow, with API integrations, GSAP animations and performance optimization.</p>
<img class="hero-architecture" src="/assets/images/hero-brutalist-extended.webp" alt="" width="535" height="600" decoding="async"/>
<div class="square-actions"><button data-go="4">My works</button><a href="mailto:gekachumak@gmail.com">Contact me</a></div>
</div>}
{i===1&&<div class="design-content">
<img class="about-tower" src="/assets/images/about-brutalist-tower.png" alt="" width="677" height="1355" decoding="async"/>
<div class="about-portrait"><div class="about-portrait-crop"><img src="/assets/images/about-portrait.png" alt="Portrait of Yevhen" decoding="async"/></div></div>
<h2 class="about-title">From initial concept to final launch.</h2>
<p class="about-description">I've grown from developing individual pages to leading the development of entire websites. Today, I bring together frontend engineering, design, and motion — making technical decisions, solving complex challenges, and taking responsibility for the entire development process.</p>
</div>}
{i===2&&<div class:list={['design-content','career-content',{'career-later':face%2===1}]}>
{face%2===0&&<h2>My path so far</h2>}
{career[face%2].map(([year,title,description],index)=>{
 const [x,y]=(face%2===0?[[0,95],[-121,385]]:[[-153,-134],[0,150],[-124,434]])[index];
 return <div class="career-row" style={`--row-direction:${index%2===0?1:-1}`}>
 <img class="career-duct" src="/assets/images/timeline-ductway.png" alt="" width="1803" height="601" style={`left:${x}px;top:${y}px`} decoding="async"/>
 <article class={`career-card career-card-${index}`}><div><p class="career-year">{year}</p><h3>{title}</h3></div><p>{description}</p></article>
 </div>
})}

</div>}
{i===3&&<div class="design-content works-content">
<h2 class="works-accessible-title">My works</h2>
<div class="works-white" aria-hidden="true"></div>
{[
 {y:75,x:40,next:953,portraitX:953,portraitY:37,offset:0},
 {y:295,x:40,next:937,portraitX:40,portraitY:252,offset:-5},
 {y:493,x:54,next:967,portraitX:967,portraitY:455,offset:0},
 {y:713,x:54,next:951,portraitX:54,portraitY:670,offset:-5},
].map((row,index)=><>
<div class="works-text-row" aria-hidden="true" style={`top:${row.y}px;--row-direction:${index%2===0?1:-1}`}>
<span style={`left:${row.x}px`}>MY WORKS</span><span style={`left:${row.next}px;top:${row.offset}px`}>MY WORKS</span>
</div>
<div class:list={["works-portrait",{"works-portrait-light":index>1}]} style={`left:${row.portraitX}px;top:${row.portraitY}px;--row-direction:${index%2===0?1:-1}`}><div class="about-portrait-crop"><img src="/assets/images/about-portrait.png" alt="" width="836" height="1002" decoding="async"/></div></div>
</>)}
</div>}
{i>=4&&<CasePanel project={projects[i-4]} face={face}/>}
 </section>)}
 {m.n>1&&[0,i===2?1120:640].map(edge=>{const half=i===2?320:560;const r=half/Math.sin(Math.PI/m.n);const points=Array.from({length:m.n},(_,j)=>{const a=Math.PI/m.n+j*2*Math.PI/m.n;return i===2?`${50-50*Math.cos(a)}% ${50+50*Math.sin(a)}%`:`${50+50*Math.sin(a)}% ${50+50*Math.cos(a)}%`}).join(',');return <div class="prism-cap" style={`width:${2*r}px;height:${2*r}px;left:${i===2?edge-r:560-r}px;top:${i===2?320-r:edge-r}px;transform:${i===2?'rotateY(90deg)':'rotateX(90deg)'};clip-path:polygon(${points})`}></div>})}
 </div>
</div>)}
</div></div></main>
<aside class="controls-hint" role="dialog" aria-labelledby="controls-title" hidden>
<button class="hint-close" aria-label="Закрыть подсказку">×</button>
<p id="controls-title">Выбирай свой темп</p>
<p>Горизонтальная труба: <kbd>←</kbd> <kbd>→</kbd> — переход между блоками, <kbd>↑</kbd> <kbd>↓</kbd> — вращение фигуры.</p>
<p>Вертикальная труба: <kbd>↑</kbd> <kbd>↓</kbd> — переход между блоками, <kbd>←</kbd> <kbd>→</kbd> — вращение фигуры.</p>
<p>Скролл — движение по маршруту и просмотр граней. В «My path so far» два экрана истории, затем маршрут продолжается вправо. ←/→ — переход между блоками.</p>
<button class="hint-dismiss">Понятно</button>
</aside>
<script is:inline>
(() => {
 const loader=document.querySelector('.preloader');
 const stage=document.querySelector('.stage');
 stage.setAttribute('aria-busy','true');
 const images=[...document.querySelectorAll('.hero-architecture,.about-tower,.about-portrait img,.career-duct')];
 let fallback;
 Promise.race([
  Promise.allSettled([document.fonts.ready,...images.map(img=>img.decode())]),
  new Promise(resolve=>{fallback=setTimeout(resolve,6000)})
 ]).then(()=>{
  clearTimeout(fallback);
  stage.removeAttribute('aria-busy');
  loader.classList.add('is-ready');
  setTimeout(()=>loader.remove(),220);
 });
})();
</script>
<script src="../falling-panels.ts"></script>
</body></html>
